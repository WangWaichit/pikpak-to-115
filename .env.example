# ===== PikPak 配置（二选一） =====
# 方式 1【推荐】：官方开发者后台生成的长期访问令牌 (Long-term Access Token)
#   从 PikPak 网页版「设置 / 开发者 / API」里生成，直接粘进来即可，无需刷新
PIKPAK_LONG_TERM_TOKEN=

# 方式 2【备选】：OAuth 登录流程拿到的 refresh_token（会自动换 access_token）
# PIKPAK_REFRESH_TOKEN=

# 要同步的 PikPak 目录，留空 = 整个网盘根目录
# 例： /离线下载/电影
PIKPAK_SOURCE_DIR=

# ===== 115 网盘配置 =====
# 浏览器登录 115 后，从 Cookie 里复制这四个值，拼成一行
PAN115_COOKIES=UID=xxxx; CID=xxxx; SEID=xxxx; KID=xxxx

# 115 上的目标目录（不存在会自动创建）
PAN115_TARGET_DIR=/pikpak

# ===== 其它 =====
# 临时下载目录（小内存 VPS 请留到磁盘够大的分区，比如 /tmp 或 /root/tmp）
TMP_DIR=/tmp/pikpak_sync
